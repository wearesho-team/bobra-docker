{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Run by .github/workflows/renovate.yml, see the Updates section of README.md",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": ["dependencies"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "{{parentDir}}:",
  "commitMessageAction": "upgrade",
  "separateMinorPatch": true,
  "prHourlyLimit": 0,
  "prBodyNotes": ["Publish after merging: `PUBLISH=1 ./build`"],
  "postUpgradeTasks": {
    "commands": ["./sync origin/{{{baseBranch}}}"],
    "executionMode": "branch"
  },
  "customDatasources": {
    "pecl": {
      "defaultRegistryUrlTemplate": "https://pecl.php.net/rest/r/{{packageName}}/allreleases.xml",
      "format": "plain"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Git commits pinned in Dockerfiles (ngx_brotli)",
      "managerFilePatterns": ["**/Dockerfile"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) branch=(?<currentValue>\\S+)\\s+(?:ENV|ARG) \\w+_COMMIT=(?<currentDigest>[0-9a-f]{40})\\s"
      ]
    },
    {
      "customType": "regex",
      "description": "Images pinned by digest in *_IMAGE variables of workflows (Trivy)",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "[A-Z0-9_]+_IMAGE:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[0-9a-f]{64})\\s"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "PECL lists every release in allreleases.xml, one per line; keep the stable ones",
      "matchDatasources": ["custom.pecl"],
      "extractVersion": "<v>(?<version>[^<]+)</v><s>stable</s>",
      "versioning": "semver"
    },
    {
      "description": "Images: patch releases and rebuilt base images get a PR right away, minor and major releases wait for approval on the Dependency Dashboard",
      "matchFileNames": ["nginx/**", "php/**"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "CI tooling: one PR a week, with releases at least a week old",
      "matchFileNames": [".github/**"],
      "groupName": "CI tooling",
      "commitMessagePrefix": "ci:",
      "separateMinorPatch": false,
      "schedule": ["* 0-5 * * 1"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "No release dates to wait for: ghcr.io does not report them, and neither do runner images",
      "matchFileNames": [".github/**"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate", "ubuntu"],
      "minimumReleaseAge": null
    },
    {
      "matchFileNames": [".github/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
