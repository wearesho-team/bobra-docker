#!/usr/bin/env bash

# Updates the values that follow from the pinned versions after one of them
# changed: the xdebug tarball checksum and the image tags in meta.json.
# Renovate runs it on every update branch (see renovate.json). After editing a
# Dockerfile by hand, run it before committing.
#   ./sync [REF]
# REF is the git revision to compare against, HEAD by default.
#
# An image whose inputs differ from REF gets a new tag, unless its tag was
# already changed by hand. The new tag is the upstream version when that
# changed, otherwise the next revision of the old tag:
#   1.31.4 -> 1.31.4.1 -> 1.31.4.2 -> (nginx 1.31.5) -> 1.31.5
# Without a new tag `PUBLISH=1 ./build` would skip the image as already
# published.
set -euo pipefail
cd "$(dirname "$0")"

REF=${1:-HEAD}

# Value of an ENV/ARG instruction in the Dockerfile on stdin.
function dockerfile_var() {
    sed -nE "/^(ENV|ARG) ${1}=/{s/^[^=]*=([^[:space:]]+).*/\1/p;q;}"
}
# Rewrites a file through a filter command, e.g. `rewrite FILE sed -E 's/a/b/'`.
# Avoids `sed -i`, which takes different arguments on GNU and BSD.
function rewrite() {
    local file=$1
    shift
    "$@" < "${file}" > "${file}.tmp"
    mv "${file}.tmp" "${file}"
}
function tag_at_ref() {
    git show "${REF}:${1}/meta.json" 2> /dev/null | jq -r '.tag // empty'
}
function tag() {
    jq -r .tag "${1}/meta.json"
}
function set_tag() {
    if [[ "$(tag "${1}")" != "${2}" ]]; then
        # shellcheck disable=SC2016 # $tag is a jq variable
        rewrite "${1}/meta.json" jq --arg tag "${2}" '.tag = $tag'
        echo "${1}: tag ${2}"
    fi
}
# needs_tag DIR PATHSPEC...: whether the image's inputs changed since REF while
# its tag did not.
function needs_tag() {
    local dir=$1
    shift
    ! git diff --quiet "${REF}" -- "$@" && [[ "$(tag "${dir}")" == "$(tag_at_ref "${dir}")" ]]
}
# next_tag OLD_TAG VERSION
function next_tag() {
    local revision
    if [[ "${1}" == "${2}" ]]; then
        echo "${2}.1"
    elif [[ "${1}" == "${2}."* ]]; then
        revision=${1#"${2}."}
        if [[ ! "${revision}" =~ ^[0-9]+$ ]]; then
            echo "Unable to read a revision from tag '${1}'" > /dev/stderr
            exit 1
        fi
        echo "${2}.$((revision + 1))"
    else
        echo "${2}"
    fi
}
# registry_get IMAGE TOKEN PATH ACCEPT: GET from a Docker Hub official image.
function registry_get() {
    curl -fsSL -H "Authorization: Bearer ${2}" -H "Accept: ${4}" \
        "https://registry-1.docker.io/v2/library/${1}/${3}"
}
# PHP version inside a Docker Hub official image (linux/amd64), read from the
# registry so that no docker daemon is needed, e.g. composer:2.10.3@sha256:...
function image_php_version() {
    local name=${1%%[:@]*} reference=${1#*:} token manifest config
    if [[ "${1}" == *@* ]]; then
        reference=${1#*@}
    fi
    token=$(curl -fsSL "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/${name}:pull" | jq -r .token)
    manifest=$(registry_get "${name}" "${token}" "manifests/${reference}" \
            'application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json' \
        | jq -r '[.manifests[] | select(.platform.os == "linux" and .platform.architecture == "amd64")][0].digest')
    config=$(registry_get "${name}" "${token}" "manifests/${manifest}" \
            'application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json' \
        | jq -r .config.digest)
    registry_get "${name}" "${token}" "blobs/${config}" '*/*' \
        | jq -er '.config.Env[] | select(startswith("PHP_VERSION=")) | ltrimstr("PHP_VERSION=")'
}

# The pinned xdebug tarball checksum.
XDEBUG_VERSION=$(dockerfile_var XDEBUG_VERSION < php/Dockerfile)
if [[ "${XDEBUG_VERSION}" != "$(git show "${REF}:php/Dockerfile" | dockerfile_var XDEBUG_VERSION)" ]]; then
    XDEBUG_SHA256=$(curl -fsSL "https://pecl.php.net/get/xdebug-${XDEBUG_VERSION}.tgz" | sha256sum | cut -d' ' -f1)
    rewrite php/Dockerfile sed -E "s/^(ARG XDEBUG_SHA256=).*/\1${XDEBUG_SHA256}/"
    echo "php/Dockerfile: xdebug ${XDEBUG_VERSION} sha256 ${XDEBUG_SHA256}"
fi

# bobra/php and its -debug variant are built from the same php/Dockerfile and
# always released together, tagged with the PHP version of the base image.
if needs_tag php php ':(exclude)php/composer' ':(exclude)*meta.json' ':(exclude)*.md'; then
    VERSION=$(sed -nE 's/^FROM php:([0-9.]+)-alpine.*/\1/p' php/Dockerfile)
    TAG=$(next_tag "$(tag_at_ref php)" "${VERSION}")
    set_tag php "${TAG}"
    set_tag php/debug "${TAG}-debug"
fi

# bobra/php-composer is tagged with the PHP version the composer image ships.
if needs_tag php/composer php/composer ':(exclude)*meta.json' ':(exclude)*.md'; then
    VERSION=$(image_php_version "$(sed -nE 's/^FROM (composer:[^[:space:]]+).*/\1/p' php/composer/Dockerfile)")
    TAG=$(next_tag "$(tag_at_ref php/composer)" "${VERSION}")
    set_tag php/composer "${TAG}"
fi

# bobra/nginx is tagged with the nginx version.
if needs_tag nginx nginx ':(exclude)*meta.json' ':(exclude)*.md'; then
    VERSION=$(dockerfile_var NGINX_VERSION < nginx/Dockerfile)
    TAG=$(next_tag "$(tag_at_ref nginx)" "${VERSION}")
    set_tag nginx "${TAG}"
fi
